[resource]
script = ExtResource("1_sponsor")
sponsor_name = "Heracles"
mythological_source = "Greek mythology"
manifestation_description = "A manifestation of humanity's enduring image of Heracles: strength, perseverance, and the will to overcome impossible trials."
ideological_themes = ["strength", "perseverance", "overcoming trials", "heroism"]
personality_description = "Direct, demanding, encouraging, and intensely focused on overcoming adversity. This is humanity's interpretation of Heracles, not the literal mythological figure."
personality_traits = ["determined", "blunt", "protective", "competitive"]
relationship_note = "Heracles respects Valentin's drive to finish what he begins and pushes him to treat obstacles as trials rather than excuses."
compatibility_groups = ["warrior", "conqueror"]
affinity_profile = SubResource("AffinityProfile_heracles")
skills = [SubResource("Skill_mighty_strike"), SubResource("Skill_lions_hide"), SubResource("Skill_heroic_blow"), SubResource("Skill_labors_resolve")]
passive_traits = ["Trial by Strength: intended to reward aggressive play and endurance."]
max_active_skills = 8
level = 1
experience = 0
passive_slots = 1
evolution_description = "At maximum level, Heracles can evolve into a stronger manifestation representing humanity's increasingly transcendent image of the hero."
