@@ -0,0 +1,35 @@
+class_name UnitStatusCard
+extends PanelContainer
+
+## Compact party member card: name, HP bar, SP bar.
+## Call bind() once after adding to the tree, then refresh() whenever stats change.
+
+var unit: BattleUnit
+
+@onready var name_label: Label = $Margin/VBox/NameLabel
+@onready var hp_bar: ProgressBar = $Margin/VBox/HPBar
+@onready var sp_bar: ProgressBar = $Margin/VBox/SPBar
+@onready var stats_label: Label = $Margin/VBox/StatsLabel
+
+func bind(new_unit: BattleUnit) -> void:
+    unit = new_unit
+    refresh(false)
+
+func refresh(animate := true) -> void:
+    if unit == null or not is_node_ready():
+        return
+    name_label.text = unit.unit_name
+    hp_bar.max_value = unit.max_hp
+    sp_bar.max_value = unit.max_sp
+    if animate:
+        var tween := create_tween().set_parallel(true)
+        tween.tween_property(hp_bar, "value", unit.hp, 0.25)
+        tween.tween_property(sp_bar, "value", unit.sp, 0.25)
+    else:
+        hp_bar.value = unit.hp
+        sp_bar.value = unit.sp
+    stats_label.text = "HP %d/%d   SP %d/%d" % [unit.hp, unit.max_hp, unit.sp, unit.max_sp]
+    modulate = Color.WHITE if unit.is_alive() else Color(0.5, 0.45, 0.5, 1.0)
+
+func set_active(active: bool) -> void:
+    theme_type_variation = &"ActiveCard" if active else &""
