@@ -0,0 +1,36 @@
+class_name PartyHUD
+extends CanvasLayer
+
+## Party panel shown on the right edge of the screen.
+## In a battle scene it finds the sibling BattleManager automatically.
+## Elsewhere, call set_party() with an Array of BattleUnit and refresh() as stats change.
+
+const CARD_SCENE := preload("res://scenes/ui/UnitStatusCard.tscn")
+
+@onready var party_list: VBoxContainer = $Root/PartyList
+
+var manager: BattleManager
+var cards: Array[UnitStatusCard] = []
+
+func _ready() -> void:
+    manager = get_parent().get_node_or_null("BattleManager") as BattleManager
+    if manager != null:
+        manager.battle_updated.connect(refresh)
+        # Deferred so the manager has finished building its party.
+        set_party.call_deferred(manager.party)
+
+func set_party(units: Array) -> void:
+    for card in cards:
+        card.queue_free()
+    cards.clear()
+    for unit in units:
+        var card := CARD_SCENE.instantiate() as UnitStatusCard
+        party_list.add_child(card)
+        card.bind(unit)
+        cards.append(card)
+    refresh()
+
+func refresh() -> void:
+    for card in cards:
+        card.refresh()
+        card.set_active(manager != null and card.unit == manager.current_actor)
diff --git a/scripts/ui/unit_status_card.gd b/scripts/ui/unit_status_card.gd
